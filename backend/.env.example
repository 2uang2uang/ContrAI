# Server Configuration
PORT=8080
NODE_ENV=development

# Gemini AI API Key
GEMINI_API_KEY=

# Subscan API Key
SUBSCAN_API_KEY=

# Polkadot RPC Endpoint
POLKADOT_RPC=wss://rpc.polkadot.io

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Smart Contract Addresses
REPUTATION_REGISTRY_ADDRESS=
REPUTATION_BADGE_ADDRESS=

# Oracle Signer (Dùng chung Private Key với ví Deployer để đơn giản)
# Thay bằng 12 từ khóa bí mật của ví Oracle (Ví dụ dùng để phát hành điểm)
ORACLE_PRIVATE_KEY=


SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
